{
  "mode": "demo",
  "currency": "USD",
  "lookback_days": 900,
  "forward_days": 5,
  "rebalance_every_days": 5,
  "evaluation_horizons": [5, 20],
  "risk_free_annual": 0.03,
  "backtest": {
    "signal_delay_days": 1,
    "commission_bps": 1.0,
    "slippage_bps": 5.0,
    "walk_forward_train_days": 400,
    "walk_forward_test_days": 100
  },
  "cache": {
    "enabled": true,
    "stale_if_error": true,
    "ttl_seconds": 21600,
    "ttl_by_namespace": {
      "alpha_vantage": 21600,
      "news": 43200,
      "fred": 86400,
      "coinmarketcap": 21600,
      "tiingo": 21600,
      "yahoo_finance": 21600
    }
  },
  "provider_fallbacks": {
    "alpha_vantage": ["yahoo_finance"]
  },
  "network": {
    "skip_weekend_full_runs": true,
    "alpha_vantage_min_interval_seconds": 1.2,
    "coinmarketcap_min_interval_seconds": 2.0,
    "tiingo_min_interval_seconds": 1.0,
    "yahoo_finance_min_interval_seconds": 0.5,
    "default_min_interval_seconds": 0.0,
    "provider_cooldown_seconds": 300,
